# ============================================================================
# FMF Terminal — .env.local template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values, then restart dev:
#     cp .env.local.example .env.local && npm run dev
#
# See docs/ENVIRONMENT_SETUP.md for where to obtain each key.
#
# Integrations are env-guarded: when a section's keys are absent that feature
# degrades gracefully (the app still builds and runs). For a full SaaS launch,
# set everything in the REQUIRED section.
# ============================================================================


# ============================================================================
# REQUIRED
# ============================================================================

# ── Supabase (database + existing community/watchlist/auth) ─────────────────
# Project URL + anon key are PUBLIC (browser-side). Service role key is SECRET
# (server-only SaaS bookkeeping: app_users, usage_events, subscriptions).
# Service: Supabase  | https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role-key

# ── OpenAI (AI Intelligence Layer + Market Summary) ─────────────────────────
# Service: OpenAI  | https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Clerk (authentication) ──────────────────────────────────────────────────
# Publishable key is PUBLIC; secret key is SECRET.
# Service: Clerk  | https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe (billing) ────────────────────────────────────────────────────────
# Secret key + webhook signing secret are SECRET. The price id is the Pro
# monthly recurring price; checkout is disabled without it.
# Service: Stripe  | https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe → Developers → Webhooks → (your endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe → Product catalog → Pro product → monthly Price → API ID (price_...)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (daily quotas + rate limiting + AI cache) ─────────────────
# Required in production for cross-instance quotas/rate limiting.
# Service: Upstash  | https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-db-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXAAIjcDExxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================================
# RECOMMENDED
# ============================================================================

# ── Public site / app URL (canonical URLs, OG tags, Stripe/Clerk redirects) ─
# In production set to your real domain. NEXT_PUBLIC_APP_URL overrides
# NEXT_PUBLIC_SITE_URL for billing redirects; either works.
NEXT_PUBLIC_SITE_URL=https://www.fmfterminal.com
NEXT_PUBLIC_APP_URL=https://www.fmfterminal.com

# ── Clerk webhook (syncs Clerk users into the app_users table) ──────────────
# Service: Clerk  | Dashboard → Webhooks → endpoint /api/webhooks/clerk → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin access (comma-separated Clerk user IDs granted /admin access) ─────
# Find your Clerk user id in Clerk Dashboard → Users (user_...).
ADMIN_CLERK_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxx,user_yyyyyyyyyyyyyyyyyyyy

# ── Market data providers (candles + AI context: news, fundamentals) ────────
# Service: Finnhub     | https://finnhub.io/dashboard
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Service: Twelve Data | https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=xxxxxxxxxxxxxxxxxxxx
# Yahoo / Binance public APIs require no key.


# ============================================================================
# OPTIONAL
# ============================================================================

# ── Clerk hosted route overrides (defaults are fine) ────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── OpenAI model overrides (sensible defaults are built in) ─────────────────
# Market summary model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Fast tier — news + explain-move (default: gpt-4.1-mini)
# OPENAI_FAST_MODEL=gpt-4.1-mini
# Deep tier — research reports + earnings (default: gpt-5)
# OPENAI_DEEP_MODEL=gpt-5
# Final failover model (default: gpt-4o-mini)
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Supabase server URL alias ───────────────────────────────────────────────
# The service-role client accepts SUPABASE_URL as an alternative to
# NEXT_PUBLIC_SUPABASE_URL. The browser client still needs the NEXT_PUBLIC_ one.
# SUPABASE_URL=https://abcdefghijklmno.supabase.co

# ── Vercel KV aliases (alternative names for the same Upstash store) ────────
# If you provision Vercel KV instead of Upstash directly, these aliases work
# for the AI cache + quotas + rate limiting.
# KV_REST_API_URL=https://your-db-12345.upstash.io
# KV_REST_API_TOKEN=AXXXAAIjcDExxxxxxxxxxxxxxxxxxxxxxxx
