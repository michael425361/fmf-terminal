# Public site URL (required for canonical URLs, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.fmfterminal.com

# Supabase Auth (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Add every dev callback URL to Supabase Redirect URLs, e.g. http://localhost:3004/auth/callback

# Optional: Vercel sets VERCEL_URL automatically in preview deployments
# NEXT_PUBLIC_SITE_URL is used in production — set in Vercel Project Settings

# OpenAI — AI Market Summary + AI Intelligence Layer — REQUIRED for AI features
# Copy to .env.local, then restart: npm run dev
OPENAI_API_KEY=sk-your-key-here
# Optional override for the market summary model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# AI Intelligence Layer model routing (optional overrides)
# Fast tier: news summary/ranking, explain-move (default: gpt-4.1-mini)
# OPENAI_FAST_MODEL=gpt-4.1-mini
# Deep tier: research reports, earnings analysis (default: gpt-5)
# OPENAI_DEEP_MODEL=gpt-5
# Final failover model (default: gpt-4o-mini)
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# AI cache + quotas + rate limiting — Upstash Redis REST (KV_* aliases also work)
# Required in production for daily quotas + distributed rate limiting.
# UPSTASH_REDIS_REST_URL=https://your-kv.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-kv-rest-token
# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=your-kv-rest-token

# Market data providers (candles + AI context: news, fundamentals, sectors)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
# Yahoo / Binance public APIs need no keys

# ──────────────────────────────────────────────────────────────────────
# Phase 3 — SaaS launch (auth, billing, quotas). All optional at build time;
# when unset the app runs in its pre-SaaS public mode (backward compatible).
# ──────────────────────────────────────────────────────────────────────

# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Locale prefix required (localePrefix: "always" in src/i18n/routing.ts)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up
# Clerk webhook (user.created/updated/deleted -> app_users sync)
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase service role key — server-only SaaS bookkeeping (NEVER expose client-side)
# The service-role client accepts SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=

# Absolute app URL for Stripe/Clerk redirects (falls back to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin access bootstrap — comma-separated Clerk user IDs
ADMIN_CLERK_USER_IDS=
